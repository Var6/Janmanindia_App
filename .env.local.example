# Copy to .env.local (never commit) and fill before `npm run dev`.

# MongoDB connection string — local for dev, Atlas for prod
MONGODB_URI=mongodb://localhost:27017/janman

# JWT signing secret — must be at least 32 characters
# Generate one with: openssl rand -hex 48
JWT_SECRET=

# Public URL of the app — used by the logout redirect
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional integrations — leave blank to disable

# Vercel Blob (auto-set by Vercel when a Blob store is connected)
# BLOB_READ_WRITE_TOKEN=

# Google Calendar (single-line service-account JSON + calendar id)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CALENDAR_ID=primary

# Airtable mirror
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# OCR service
# OCR_SERVICE_KEY=

# Google sign-in (OAuth Web Client) — credentials for the "Sign in with Google" flow
# on the /login page. Authorized redirect URIs in Google Cloud must include
# {NEXT_PUBLIC_APP_URL}/api/auth/login-google/callback.
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=

# Insights
# CRON_SECRET protects the cron routes, including the daily alerts run
# (/api/insights/alerts/run). Vercel sends it automatically once set.
# CRON_SECRET=
# Copilot needs ANTHROPIC_API_KEY. A director then switches it on in
# Insights > Settings, which is where the consent for grouped totals to go
# to Anthropic is recorded. INSIGHTS_COPILOT=off forces it off whatever the
# Settings screen says; INSIGHTS_COPILOT=on only sets the starting position
# before anybody has saved the Settings screen.
# ANTHROPIC_API_KEY=
# INSIGHTS_COPILOT=off
# INSIGHTS_COPILOT_MODEL=claude-sonnet-4-5
# KoboToolbox imports: an API token from a Kobo account that can read the
# forms, and the server (kf.kobotoolbox.org or eu.kobotoolbox.org).
# KOBO_API_TOKEN=
# KOBO_SERVER=https://kf.kobotoolbox.org
# Email for Insights (alert emails, emailed reports, @mentions). Off until
# SMTP_HOST and MAIL_FROM are set. With Google Workspace: smtp.gmail.com,
# port 465, and an app password for the sending mailbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=insights@janmanindia.org
# SMTP_PASS=
# MAIL_FROM=Janman Insights <insights@janmanindia.org>
# Slack needs no setting here: each alert takes its own incoming-webhook link.

# Insights data connectors. Each one appears in Insights > Data > Import and
# shows "Not connected yet" until its settings are here. All are read-only.
# Airtable uses AIRTABLE_API_KEY (above): a personal access token that can
# read the bases you want to import.
# SurveyCTO: the server name (e.g. janman.surveycto.com) and a login with
# the "can download data" permission.
# SURVEYCTO_SERVER=
# SURVEYCTO_USER=
# SURVEYCTO_PASSWORD=
# CommCare: a web user's email and API key. COMMCARE_HOST only for the
# India server (india.commcarehq.org).
# COMMCARE_USERNAME=
# COMMCARE_API_KEY=
# COMMCARE_HOST=www.commcarehq.org
# Avni: an auth token (these expire; replace it when imports start failing).
# AVNI_AUTH_TOKEN=
# AVNI_SERVER=https://app.avniproject.org
# Salesforce: a connected app set up for the client-credentials flow.
# SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# PostgreSQL: a connection string for a read-only database user.
# INSIGHTS_PG_URL=postgres://readonly_user:password@host:5432/dbname

# Uploaded files (ID images, case documents). With FILES_PRIVATE=on, new
# uploads are stored as /api/files/... links that only signed-in users can
# open, instead of public bucket links. Follow the order in
# scripts/migrate-file-urls.mjs before turning it on in production.
# FILES_PRIVATE=on
