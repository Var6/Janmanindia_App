# Copy to .env.local (never commit) and fill before `npm run dev`.

# MongoDB connection string — local for dev, Atlas for prod
MONGODB_URI=mongodb://localhost:27017/janman

# JWT signing secret — must be at least 32 characters
# Generate one with: openssl rand -hex 48
JWT_SECRET=

# Public URL of the app — used by the logout redirect
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional integrations — leave blank to disable

# Vercel Blob (auto-set by Vercel when a Blob store is connected)
# BLOB_READ_WRITE_TOKEN=

# Google Calendar (single-line service-account JSON + calendar id)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CALENDAR_ID=primary

# Airtable mirror
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# OCR service
# OCR_SERVICE_KEY=

# Google sign-in (OAuth Web Client) — credentials for the "Sign in with Google" flow
# on the /login page. Authorized redirect URIs in Google Cloud must include
# {NEXT_PUBLIC_APP_URL}/api/auth/login-google/callback.
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=

# Insights
# CRON_SECRET protects the cron routes, including the daily alerts run
# (/api/insights/alerts/run). Vercel sends it automatically once set.
# CRON_SECRET=
# Copilot stays off until a director decides aggregate figures may go to
# Anthropic. It needs ANTHROPIC_API_KEY as well.
# INSIGHTS_COPILOT=on
# INSIGHTS_COPILOT_MODEL=claude-sonnet-4-5
# KoboToolbox imports: an API token from a Kobo account that can read the
# forms, and the server (kf.kobotoolbox.org or eu.kobotoolbox.org).
# KOBO_API_TOKEN=
# KOBO_SERVER=https://kf.kobotoolbox.org
# Email for Insights (alert emails, emailed reports, @mentions). Off until
# SMTP_HOST and MAIL_FROM are set. With Google Workspace: smtp.gmail.com,
# port 465, and an app password for the sending mailbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=insights@janmanindia.org
# SMTP_PASS=
# MAIL_FROM=Janman Insights <insights@janmanindia.org>
# Slack needs no setting here: each alert takes its own incoming-webhook link.
